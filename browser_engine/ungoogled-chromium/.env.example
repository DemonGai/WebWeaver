# 复制成 .env 后生效；不复制则全部走 docker-compose.yaml 里的默认值

# 要构建/运行的版本，必须和本目录下的版本文件夹名完全一致
CHROMIUM_VERSION=156.0.8078.79

# 1 = 带 Xvfb + x11vnc + noVNC（能看画面，镜像约多 90MB）
# 0 = 只留 CDP，最精简
WITH_VNC=1

# vnc 默认：打开 http://localhost:6080/vnc.html 就能看到浏览器界面
# headless：只开 CDP，给后端 / Playwright 用
MODE=vnc

# 构建用的基础镜像与 apt 源。国内默认走清华，海外可换回 deb.debian.org
BASE_IMAGE=debian:bookworm-slim
APT_MIRROR=mirrors.tuna.tsinghua.edu.cn

# 宿主机端口，两个版本同时跑时至少改一个
CDP_HOST_PORT=9222
NOVNC_HOST_PORT=6080

# vnc 模式的虚拟屏分辨率
SCREEN=1920x1080x24

# 启动页；给后端当内核用就保持 about:blank
START_URL=about:blank

# 追加给 chrome 的原始参数，例如：
# CHROME_ARGS=--lang=zh-CN --proxy-server=socks5://10.0.0.5:1080
CHROME_ARGS=

# 1 = 关沙箱（容器内默认），0 = 保留
CHROME_NO_SANDBOX=1
