# 复制成 .env 后按需改（docker compose 会自动读同目录的 .env）

# ── 版本 ─────────────────────────────────────────────────────────────
# 必须和本目录下的版本文件夹名一致
CLOAKBROWSER_VERSION=146.0.7680.177.5

# 1 = 带 Xvfb + x11vnc + noVNC（能看画面，镜像约多 500MB）
# 0 = 只留 CDP，最精简
WITH_VNC=1

# vnc 能看到浏览器界面；headless 只开 CDP，适合纯自动化
MODE=vnc

# ── 端口 ─────────────────────────────────────────────────────────────
# 和 ungoogled-chromium 那套错开，两边可以同时跑
CB_CDP_HOST_PORT=9232
CB_NOVNC_HOST_PORT=6082

# ── 画面 ─────────────────────────────────────────────────────────────
SCREEN=1920x1080x24
START_URL=about:blank

# ── 指纹（动态下发）─────────────────────────────────────────────────
# 六项全留空时：读 /data/fingerprint.json → 再没有就沿用 profile 上次的种子。
# 后端按画像起容器时，把这些填上最直接。
#
# 种子范围固定 10000–99999，越界会被当成无效值忽略。
FINGERPRINT_SEED=
# windows | macos | linux，留空 = windows（官方在 Linux 上的默认人格）
FINGERPRINT_PLATFORM=
# IANA 时区名，例如 Asia/Shanghai。要和出口代理的 IP 归属地对上
FINGERPRINT_TIMEZONE=
# 例如 zh-CN。会影响 navigator.language 与 Accept-Language
FINGERPRINT_LOCALE=
# 上面 locale 的 --lang 部分，一般和 FINGERPRINT_LOCALE 填一样
FINGERPRINT_LANG=
# WebRTC 会绕过代理直连、暴露真实 IP，填上出口 IP 把这条堵掉
FINGERPRINT_WEBRTC_IP=

# 指纹文件路径（容器内）。默认 /data/fingerprint.json，
# 也就是宿主机 ./data/<版本>/fingerprint.json
FINGERPRINT_FILE=/data/fingerprint.json

# ── 其它 ─────────────────────────────────────────────────────────────
# 追加给 chrome 的原始参数，空格分隔。代理一般从这里进：
# CHROME_ARGS=--proxy-server=socks5://192.168.1.10:1080
CHROME_ARGS=

# 容器里默认关沙箱
CHROME_NO_SANDBOX=1

TZ=Asia/Shanghai
