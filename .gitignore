# 前端
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/*.local

# 后端
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
backend/*.pyc
backend/.env
backend/.pytest_cache/
backend/.ruff_cache/

# 预览产物
.preview/

# 通用
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/

# 工作区数据（截图、记忆、临时产物）
.workbuddy/

# 前端锁文件只保留 bun.lock（README 声明包管理用 bun），npm 装的锁文件不入库
frontend/package-lock.json

# 后端日志
backend/logs/
# aria2c（5.6MB 单文件下载器，本机已有就该用它；不放仓库，首次部署用 scripts/get-aria2.sh 拉）
backend/bin/aria2c.exe
backend/bin/aria2c
# 内核文件目录（真实二进制太大，本地按需生成）
# 目录本身放行、只忽略文件，否则 git 不会进目录，下面的白名单也失效；
# engine.json 是人工维护的引擎档案、README.md 是页面正文，两者要能提交。
# meta.json 是"本机已下载"的完工标记，属于部署现场状态，不入库 —— 否则换台机器 clone
# 下来会被误判成已安装（目录里只有几百字节的 meta.json，二进制并不存在）。
backend/browser_engine/**
!backend/browser_engine/*/
!backend/browser_engine/**/
!backend/browser_engine/**/engine.json
!backend/browser_engine/**/README.md

# 根目录的 browser_engine/<引擎>/<版本>/：放的是真实二进制（单个版本 700MB+），
# 只把容器构建文件和文档入库。加新版本只需把目录拷进来，不用改 git 规则。
browser_engine/**
!browser_engine/*/
!browser_engine/**/
!browser_engine/**/Dockerfile
!browser_engine/**/docker-compose.yaml
!browser_engine/**/docker-compose.yml
!browser_engine/**/entrypoint.sh
!browser_engine/**/.dockerignore
!browser_engine/**/.env.example
!browser_engine/**/README.md
!browser_engine/**/*.sh
!browser_engine/**/fingerprint.example.json
# fonts/ 里是自己机器的微软字体，不重新分发；只放行占位文件让目录能存在
# （Dockerfile 要 COPY fonts/，缺目录会构建失败）
!browser_engine/**/fonts/.gitkeep

# 容器运行时生成的 profile 目录
browser_engine/**/data/

# 本机账号备注（含明文密码），绝不入库
user.txt
