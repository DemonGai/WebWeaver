APP_NAME=WebWeaver API
APP_VERSION=0.1.0
API_PREFIX=/api
DEBUG=true

# 允许跨域的前端地址（JSON 数组格式）
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# PostgreSQL 18（docker-compose.yml 中的 webweaver-postgres）
DATABASE_URL=postgresql+asyncpg://webweaver:webweaver@127.0.0.1:5432/webweaver
# 表结构由 Alembic 迁移管理，启动时不再自动建表
DB_AUTO_CREATE=false

# 日志：目录为相对路径时以 backend/ 为基准
LOG_DIR=logs
LOG_LEVEL=INFO
# 异常日志是否附带变量快照，涉及密码/令牌的项目保持 false
LOG_DIAGNOSE=false

# ── 认证 ─────────────────────────────────────────────
# 双令牌：访问令牌 30 分钟（前端静默续期），刷新令牌 7 天；勾「记住我」30 天
AUTH_ACCESS_TTL_MINUTES=30
AUTH_REFRESH_TTL_MINUTES=10080
AUTH_REFRESH_TTL_REMEMBER_MINUTES=43200
# 会话硬上限：无论怎么续期，超过这个时长必须重新登录
AUTH_ABSOLUTE_TTL_MINUTES=43200
# 访问令牌签名密钥。生产环境必须换成随机值：`python -c "import secrets;print(secrets.token_hex(32))"`
AUTH_JWT_SECRET=change-me-to-a-random-64-char-hex
# Cookie 是否带 Secure。本地 http 调试关掉，对外 https 部署必须打开
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCK_MINUTES=15
AUTH_ALLOW_REGISTER=true
AUTH_RESET_TTL_MINUTES=30
# 生产环境必须 false：为 true 时接口会直接返回重置令牌
AUTH_EXPOSE_RESET_TOKEN=false
