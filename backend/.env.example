APP_NAME=WebWeaver API
APP_VERSION=0.1.0
API_PREFIX=/api
DEBUG=true

# 允许跨域的前端地址（JSON 数组格式）
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# PostgreSQL 18（docker-compose.yml 中的 webweaver-postgres）
DATABASE_URL=postgresql+asyncpg://webweaver:webweaver@127.0.0.1:5432/webweaver
# 表结构由 Alembic 迁移管理，启动时不再自动建表
DB_AUTO_CREATE=false

# 日志：目录为相对路径时以 backend/ 为基准
LOG_DIR=logs
LOG_LEVEL=INFO
# 异常日志是否附带变量快照，涉及密码/令牌的项目保持 false
LOG_DIAGNOSE=false

# ── 认证 ─────────────────────────────────────────────
AUTH_SESSION_TTL_MINUTES=720
AUTH_SESSION_TTL_REMEMBER_MINUTES=43200
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCK_MINUTES=15
AUTH_ALLOW_REGISTER=true
AUTH_RESET_TTL_MINUTES=30
# 生产环境必须 false：为 true 时接口会直接返回重置令牌
AUTH_EXPOSE_RESET_TOKEN=false
