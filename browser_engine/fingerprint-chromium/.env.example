# 复制成 .env 后按需改（docker compose 会自动读同目录的 .env）

# ── 版本 ─────────────────────────────────────────────────────────────
# 对应本目录下的 AppImage 文件名里的版本号：
#   fingerprint-chromium-<FP_VERSION>-1-x86_64.AppImage
FP_VERSION=148.0.7778.215

# 1 = 带 Xvfb + x11vnc + noVNC（能看画面，镜像约多 500MB）
# 0 = 只留 CDP，最精简
WITH_VNC=1

# vnc 能看到浏览器界面；headless 只开 CDP，适合纯自动化
MODE=vnc

# ── 端口 ─────────────────────────────────────────────────────────────
# 和另外两个内核错开，三套可以同时跑
FPC_CDP_HOST_PORT=9242
FPC_NOVNC_HOST_PORT=6084

# ── 画面 ─────────────────────────────────────────────────────────────
SCREEN=1920x1080x24
START_URL=about:blank

# ── 指纹（动态下发）─────────────────────────────────────────────────
# 全部留空时：读 /data/fingerprint.json → 再没有就沿用 profile 上次的种子。
#
# 种子范围 1–2147483647（官方是 32 位整数）。为了和 CloakBrowser 共用同一套
# 种子生成逻辑，建议还是用 10000–99999。
FINGERPRINT_SEED=
# windows | macos | linux，留空 = windows（这个内核的默认人格）
FINGERPRINT_PLATFORM=
# 系统版本，留空 = 内核按平台给默认值。例如 10.0.0 / 11.0.0
FINGERPRINT_PLATFORM_VERSION=
# UA 里报什么浏览器：Chrome | Edge | Opera | Vivaldi，留空 = Chromium
FINGERPRINT_BRAND=
# 上面品牌的版本号，留空 = 内核按品牌给默认值
FINGERPRINT_BRAND_VERSION=
# navigator.hardwareConcurrency，留空 = 由种子派生
FINGERPRINT_HARDWARE_CONCURRENCY=
# IANA 时区名，例如 Asia/Shanghai。要和出口代理的 IP 归属地对上
FINGERPRINT_TIMEZONE=
# 例如 zh-CN。留空 FINGERPRINT_LANG 时会自动顶到 --lang
FINGERPRINT_LOCALE=
# --lang 参数，一般和 FINGERPRINT_LOCALE 填一样
FINGERPRINT_LANG=
# HTTP Accept-Language，留空 = 由 FINGERPRINT_LANG 派生（zh-CN → zh-CN,zh）
FINGERPRINT_ACCEPT_LANG=
# 只关掉个别伪造项，逗号分隔：font,audio,canvas,clientrects,gpu
# 默认全开，不要习惯性填值——关错了反而更容易被认出来
FINGERPRINT_DISABLE_SPOOFING=
# 这个内核没有 --fingerprint-webrtc-ip 参数，填了只会打印一条告警。
# WebRTC 出口 IP 靠 --disable-non-proxied-udp（默认开）+ 代理本身收敛。
FINGERPRINT_WEBRTC_IP=

# 指纹文件路径（容器内）。默认 /data/fingerprint.json，
# 也就是宿主机 ./data/<版本>/fingerprint.json
FINGERPRINT_FILE=/data/fingerprint.json

# ── 其它 ─────────────────────────────────────────────────────────────
# 追加给 chrome 的原始参数，空格分隔。代理一般从这里进：
# CHROME_ARGS=--proxy-server=socks5://192.168.1.10:1080
CHROME_ARGS=

# 容器里默认关沙箱
CHROME_NO_SANDBOX=1

# 需要 WebRTC 直连（不走代理）时设 1，会去掉 --disable-non-proxied-udp
ALLOW_NON_PROXIED_UDP=0

TZ=Asia/Shanghai
